<rml>
<head>
	<title>Tooltip</title>
	<link type="text/rcss" href="common.rcss"/>
	<style>
		/* Ronin @feature 30/10/2026 DX9: the shell screens' tooltip - his description font (Options.rcss .opt-desc) in a box like his
		   open dropdown list; RmlUiManager places it by the pointer. It never takes the mouse. */
		body { position: absolute; left: 0; top: 0; width: 100%; height: 100%; pointer-events: none; }
		* { pointer-events: none; }
		#tip
		{
			position: absolute;
			max-width: 440dp;
			padding: 8dp 12dp;
			background-color: #06061AF2;
			border: 1dp #8080FF90;
			font-family: "Noto Sans";
			font-size: 16dp;
			line-height: 21dp;
			color: #B8BFDD;
		}
	</style>
</head>
<body>
	<div id="tip"></div>
</body>
</rml>
